# 1. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
bun.lock

# 2. Production & Build Outputs
dist/
dist-ssr/
build/
coverage/
*.local

# 3. Environment & Secret Credentials (STRICT NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
*.env

# Keep clean, safe, non-secret environment template
!.env.example

# 4. Local Cryptographic Keys, Databases & Data Storage (CRITICAL SECURITY)
data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.key
*.pem
*.pfx
*.pkcs8
service-account*.json
firebase-admin*.json
package_clean.ps1

# 4-b. المرحلة 1: مفاتيح التراخيص في أي مكان (الجذر، relay-server، data/) + النسخ الاحتياطية
license-keys.json
**/license-keys.json
backups/
.pfp-dev/

# 5. Logs & Diagnostic Traces
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

