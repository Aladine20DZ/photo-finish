# ══════════════════════════════════════════════════════════════
# PHOTO FINISH PRO AI — Enterprise Cloud Environment Specification
# ══════════════════════════════════════════════════════════════
# NOTE: This file is a safe, non-sensitive template.
# Copy this to .env (or configure in Vercel / Render dashboard) with real credentials.
# NEVER commit .env, private keys, or actual secret tokens to GitHub!

# ══════════════════════════════════════════════════════════════
# 1. VERCEL & FRONTEND CLIENT CONFIGURATION (VITE_*)
# (Safe to be bundled in frontend JavaScript)
# ══════════════════════════════════════════════════════════════

# 🏛️ Supabase Public Connection:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_anon_public_key_here

# 📡 Cloud Relay WebSocket Server (Render or Railway):
# Point this to your deployed Render Web Service:
VITE_RELAY_WS_URL=wss://photo-finish-relay.onrender.com

# 🔔 Firebase Cloud Messaging (FCM) Web Configuration:
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere2026
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_VAPID_KEY=BNxYourFirebaseVapidPublicKeyHereForWebPush2026

# 🛡️ Application Master Auth & Session Secrets:
VITE_DEFAULT_LEAGUE_PASSWORD=ChangeThisToYourSecureLeagueAdminPassword2026!
VITE_SESSION_SECRET=c9f8a4b3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5

# ══════════════════════════════════════════════════════════════
# 2. SERVERLESS & BACKEND PRIVATE SECRETS (NO VITE_ PREFIX)
# (Used strictly on Vercel Serverless Functions and Render Backend)
# (STRICTLY FORBIDDEN from being exposed in frontend bundle)
# ══════════════════════════════════════════════════════════════

# 🔑 Master Admin Portal Password:
ADMIN_PORTAL_PASSWORD=ChangeThisToYourMasterAdminSecretPassword2026!

# 🗄️ Supabase Service Role Key (Bypasses RLS for trusted backend operations):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_secret_service_role_key_here

# 🔏 Ed25519 Digital Licensing Keys (Asymmetric Signing):
# Keep the private key ONLY on the server:
LICENSE_PRIVATE_KEY_BASE64=your_ed25519_pkcs8_private_key_base64_here
LICENSE_PUBLIC_KEY_BASE64=QKXMTkpN9uC57U/O4G+N/9pUHyS3AgFOvrupynA3vWo=

# 🔔 Firebase Admin SDK Service Account JSON (Single-line escaped JSON string):
# Used for dispatching server-side push notifications to judges:
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# 🌐 CORS Allowed Origins (Comma-separated in production):
ALLOWED_ORIGIN=https://photo-finish.vercel.app,https://your-custom-domain.com

# ⚙️ Node Environment & Server Port:
NODE_ENV=production
PORT=8080
