# ==============================================================================
# متغيرات البيئة لنظام PHOTO FINISH PRO – Athletics Management System
# ==============================================================================

# 1. إعدادات منصة Supabase (PHOTO FINISH PRO AI - Multi-League)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# المفتاح الخاص بالخادم (Service Role) - يُمنع منعاً باتاً استخدامه في كود الواجهة الأمامية VITE
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. إعدادات الأمان والمصادقة الإدارية (Server Security)
# كلمة مرور دخول لوحة الإدارة العليا (ADMIN SUITE):
ADMIN_PORTAL_PASSWORD=ChangeThisToAStrongAdminPassword2026!

# مفتاح التوقيع غير المتماثل Ed25519 (Private Key) - خاص بالخادم حصراً:
# يستحيل تزوير أي ترخيص دون هذا المفتاح:
LICENSE_PRIVATE_KEY_BASE64=

# 3. المفتاح العام Ed25519 للعميل (Client Verification Key)
# يُضمّن في المتصفح للتحقق من سلامة التراخيص أوفلاين:
VITE_LICENSE_PUBLIC_KEY=hbH1fBBC+kL3K6u7pWufQqHoKRjM0iS/+GA5L+j0nMg=

# 4. التشفير الميداني للنقاط والأجهزة (Offline Field Security)
VITE_OFFLINE_SECRET=ChangeThisToASecureFieldSecret2026!

# 5. خادم الترحيل السحابي (Relay Server)
# اختياري: انشر خادمك من مجلد relay-server على Railway/Render ثم ضع الرابط هنا:
# VITE_RELAY_WS_URL=wss://photo-finish-relay.up.railway.app
PORT=3001

