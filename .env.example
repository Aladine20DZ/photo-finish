# 🔑 كلمة مرور بوابة الإدارة العليا (ADMIN SUITE):
# يُرجى إدخال كلمة مرور قوية وخاصة ببيئتك المحلية أو الإنتاجية
ADMIN_PORTAL_PASSWORD=change_this_to_a_secure_admin_password_2026!

# 🌐 بيانات مشروع Supabase السحابي (اختياري — يعمل النظام محلياً وأوفلاين دون إنترنت):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
