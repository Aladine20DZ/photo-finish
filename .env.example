# ══════════════════════════════════════════════════════════════
# PHOTO FINISH PRO AI — Enterprise Cloud Environment Specification
# ══════════════════════════════════════════════════════════════
# NOTE: This file is a safe, non-sensitive template — placeholders only.
# Copy to .env (or configure in Vercel / Render dashboards) with real values.
# NEVER commit .env, private keys, or actual secret tokens to GitHub!
#
# Stage 1 Security rules:
#   - NO secret under the VITE_ prefix (it is compiled into the public bundle).
#   - NO default passwords anywhere: admin login fails hard (503) without
#     ADMIN_PORTAL_PASSWORD in production.
#   - Session signing requires SESSION_SECRET on the server in production.

# ══════════════════════════════════════════════════════════════
# 1. VERCEL & FRONTEND CLIENT CONFIGURATION (VITE_* — public only)
# ══════════════════════════════════════════════════════════════

# Supabase public connection:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_anon_public_key_here

# Cloud relay WebSocket server (Render or Railway):
VITE_RELAY_WS_URL=wss://photo-finish-relay.onrender.com

# Optional: dedicated sync/licensing API base (defaults to same-origin /api)
VITE_SYNC_API_URL=

# Firebase Cloud Messaging (FCM) WEB config (public by design):
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere2026
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_VAPID_KEY=BNxYourFirebaseVapidPublicKeyHereForWebPush2026

# ══════════════════════════════════════════════════════════════
# 2. SERVER-ONLY SECRETS (NO VITE_ PREFIX — forbidden in bundle)
# Vercel Serverless + Render backend only.
# ══════════════════════════════════════════════════════════════

# Master admin portal password (REQUIRED in production — no default exists):
ADMIN_PORTAL_PASSWORD=generate_a_long_unique_password_here

# HMAC secret for server-signed league/admin session tokens (PFPs1).
# REQUIRED in production (>= 16 chars) — otherwise session issuance fails hard:
SESSION_SECRET=generate_openssl_rand_base64_48_here

# Supabase service role key (bypasses RLS — server side only):
# When set (with SUPABASE_URL) it switches sync journal + league accounts
# to durable Postgres storage (required for Vercel):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_secret_service_role_key_here

# Ed25519 digital licensing keys (private key NEVER leaves the server):
# Generate a fresh pair: node scripts/rotate-license-keys.mjs
# (old pairs published anywhere are considered burned — rotate + re-issue licenses)
LICENSE_PRIVATE_KEY_BASE64=paste_new_private_key_base64_here
LICENSE_PUBLIC_KEY_BASE64=paste_new_public_key_base64_here

# Firebase Admin SDK service account JSON (single-line escaped) for FCM push:
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key":"redacted_placeholder"}

# CORS allowlist (comma-separated). Empty = no cross-origin CORS at all.
# Example: the two Vercel deployment domains of this project:
ALLOWED_ORIGIN=https://photo-finish-beta.vercel.app,https://photo-finish-bouanani20-dz.vercel.app

# Node environment & server port:
NODE_ENV=production
PORT=8080

# Optional server storage tuning:
# PFP_DATA_DIR=./data          # where SQLite journals + generated keys live (gitignored)
# PFP_SYNC_MEMORY=1            # force in-memory stores (tests)
